# ========================================================
# VeriCrypt Backend Production Environment Variables
# ========================================================

# Server Port (Render automatically sets PORT in production)
PORT=5000

# MongoDB Atlas Connection URI (Replace with your Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.thvmxfs.mongodb.net/vericrypt?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong 32+ character random string for production)
JWT_SECRET=vericrypt_production_super_secure_jwt_secret_key_2026

# Token expiration time
JWT_EXPIRES_IN=24h

# File storage directory path (Defaults to ./uploads)
FILE_STORAGE_PATH=./uploads

# Frontend URL for CORS (Set to your Vercel URL, e.g., https://your-app.vercel.app)
# Supports comma-separated list or * for all
CLIENT_URL=http://localhost:5173

# Node Environment ('production' for Render, 'development' for local)
NODE_ENV=production

# RSA Key Size in bits (2048 or 3072)
RSA_KEY_SIZE=2048
